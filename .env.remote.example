# Remote MCP HTTP server
MCP_REMOTE_TOKEN=replace-with-a-long-random-token
MCP_AUDIT_LOG=/tmp/mcp_audit.jsonl

POSTGRES_DB=executive_insights
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-a-database-password
REMOTE_DATABASE_URL=postgresql://admin:replace-with-a-database-password@postgres:5432/executive_insights

# SQL Anywhere source used by the remote deployment.
# This must point to an isolated/anonymized database, never production.
SQLANYWHERE_HOST=host.docker.internal
SQLANYWHERE_PORT=2638
SQLANYWHERE_SERVER=ANONYMIZED_SERVER
SQLANYWHERE_DATABASE=ANONYMIZED_DATABASE
SQLANYWHERE_USER=readonly_user
SQLANYWHERE_PASSWORD=replace-me
SQLANYWHERE_DRIVER=SQL Anywhere 17
SQLANYWHERE_READ_ONLY=true

# Required by the shared application configuration.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
